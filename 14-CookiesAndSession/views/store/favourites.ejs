<%- include('../partials/head')%>
  <% const favouriteHomes=typeof favourites !=='undefined' && Array.isArray(favourites) ? favourites : []; %>
    </head>

    <body class="min-h-screen bg-slate-50 text-slate-800">
      <%- include('../partials/nav')%>
        <main class="mx-auto min-h-[calc(100vh-73px)] w-full max-w-6xl px-5 py-10 sm:px-6">
          <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="bg-linear-to-r from-rose-500 via-red-500 to-orange-500 px-5 py-7 text-white sm:px-6">
              <p class="text-sm font-semibold uppercase tracking-[0.25em] text-white/80">Saved places</p>
              <div class="mt-2 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Your favourites</h1>
                  <p class="mt-1 max-w-2xl text-sm leading-5 text-white/85">
                    Every home you marked for later appears here in one clean list.
                  </p>
                </div>
                <div class="rounded-xl bg-white/15 px-3 py-2 backdrop-blur">
                  <p class="text-xs font-medium uppercase tracking-[0.18em] text-white/75">Saved homes
                  </p>
                  <p class="mt-0.5 text-xl font-bold">
                    <%= favouriteHomes.length %>
                  </p>
                </div>
              </div>
            </div>

            <div class="px-5 py-6 sm:px-6">
              <% if (favouriteHomes.length===0) { %>
                <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center">
                  <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-white shadow-sm">
                    <span class="text-xl">♡</span>
                  </div>
                  <h2 class="mt-4 text-xl font-semibold tracking-tight text-slate-900">No favourites
                    yet
                  </h2>
                  <p class="mx-auto mt-2 max-w-md text-sm leading-5 text-slate-600">
                    Tap the favourite button on any home to save it here for quick access later.
                  </p>
                  <a href="/homes"
                    class="mt-5 inline-flex rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-700">
                    Browse homes
                  </a>
                </div>
                <% } else { %>
                  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    <% favouriteHomes.forEach((home)=> { %>
                      <article
                        class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                        <% if (home.image) { %>
                          <div class="aspect-4/3 overflow-hidden bg-slate-100">
                            <img src="<%= home.image %>" alt="<%= home.houseName %>"
                              class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                              loading="lazy" referrerpolicy="no-referrer" />
                          </div>
                          <% } else { %>
                            <div class="aspect-4/3 bg-linear-to-r from-rose-100 via-red-50 to-orange-100">
                            </div>
                            <% } %>

                              <div class="p-3.5 sm:p-4">
                                <div class="flex items-start justify-between gap-3">
                                  <div>
                                    <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-red-500">
                                      Favourite</p>
                                    <h2 class="mt-1 text-base font-semibold tracking-tight text-slate-900">
                                      <%= home.houseName %>
                                    </h2>
                                  </div>
                                  <span
                                    class="rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700">Saved</span>
                                </div>

                                <div class="mt-2.5 grid gap-2 text-sm sm:grid-cols-2">
                                  <div class="rounded-lg bg-slate-50 px-2.5 py-2">
                                    <p class="text-slate-500">Price</p>
                                    <p class="mt-0.5 font-semibold text-slate-900">
                                      <%= home.price %>
                                    </p>
                                  </div>
                                  <div class="rounded-lg bg-slate-50 px-2.5 py-2">
                                    <p class="text-slate-500">Location</p>
                                    <p class="mt-0.5 font-semibold text-slate-900">
                                      <%= home.location %>
                                    </p>
                                  </div>
                                </div>

                                <p class="mt-2.5 text-sm leading-5 text-slate-600">
                                  <%= new Date(home.date).toISOString().split('T')[0] %>
                                </p>

                                <div class="mt-3 flex items-center gap-2.5">
                                  <a href="/homes/<%= home._id %>"
                                    class="inline-flex flex-1 items-center justify-center rounded-xl bg-slate-900 px-2 py-2 text-sm font-semibold text-white transition hover:bg-slate-700">
                                    View Details
                                  </a>
                                  <a href="/homes"
                                    class="inline-flex rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
                                    More homes
                                  </a>

                                  <form action="favourites/delete/<%= home._id%>" method="POST">
                                    <button
                                      class="inline-flex bg-red-500 cursor-pointer rounded-xl border border-slate-200 px-3.5 py-2 text-sm font-semibold text-white transition hover:bg-red-800">Remove</button>
                                  </form>
                                </div>
                              </div>
                      </article>
                      <% }) %>
                  </div>
                  <% } %>
            </div>
          </section>
        </main>
    </body>

    </html>