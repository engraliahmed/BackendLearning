<header class="border-b border-slate-200 bg-white/90 shadow-sm backdrop-blur">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <h1 class="text-2xl font-semibold tracking-tight text-slate-900">
            <a href="/">
                airbnb
            </a>
        </h1>
        <nav class="flex items-center gap-3 text-sm font-medium">
            <% if (isLoggedIn) {%>
            <a href="/homes" class="rounded-full bg-red-50 px-3 py-1 text-red-600 transition hover:bg-red-100">
                Home List
            </a>

            <a href="/host/add-home"
                class="rounded-full px-3 py-1 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">
                Add Home
            </a>

            <a href="/bookings"
                class="rounded-full px-3 py-1 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">
                Bookings
            </a>

            <a href="/favourites"
                class="rounded-full px-3 py-1 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">
                Favourites
            </a>

            <a href="/host/hostHomeList"
                class="rounded-full px-3 py-1 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">
                My Homes
            </a>
            <% } %>

            <a href="/login"
                class="bg-red-500 rounded-full px-3 py-1 text-white transition hover:bg-red-600 ">
                Sign in
            </a>
        </nav>
    </div>
</header>